{
  "name": "crafter-knot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "fit": "bun scripts/fit.ts && prettier --write src/knot/strands.ts",
    "og": "magick .github/hero.jpg -crop 1600x840+0+176 +repage -filter Lanczos -resize 1200x630 -strip -interlace JPEG -quality 88 public/og.jpg",
    "format": "prettier --write ."
  },
  "dependencies": {
    "vgpu": "^0.5.0"
  },
  "devDependencies": {
    "@vgpu/wgsl": "^0.5.0",
    "@webgpu/types": "^0.1.74",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
